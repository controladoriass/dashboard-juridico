# === Dashboard de Indicadores Jurídicos — .gitignore ===

# Dados confidenciais / arquivos de trabalho local
_*.json
_*.md
*.docx
*.pdf
scratchpad/
.claude/
launch.json

# Auditoria interna — mantida local, não publicada no Pages (peso)
auditoria_processos/

# Wrapper de deploy (evita commit acidental do repo dentro do repo)
_para_github/

# Scripts Python locais (a origem de dados é externa)
*.py
__pycache__/
*.pyc
.venv/
venv/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
